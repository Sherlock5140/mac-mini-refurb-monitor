{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mac-mini-refurb-monitor-bot",
  "main": "worker/worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
      "4,34 * * * *",
      "14,44 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "MONITOR_DB",
      "database_name": "mac-mini-refurb-monitor-state",
      "database_id": "593aa5a1-38dd-4b6f-aa4b-42b29bf07096",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "ADMIN_TEST_TOKEN",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  }
}

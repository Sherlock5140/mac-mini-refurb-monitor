{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mac-mini-refurb-monitor-bot",
  "main": "worker/worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  }
}
